#!/usr/bin/env bash
set -euo pipefail

# ====================== 本地版本号配置（更新时自动修改此处）======================
# 所有本地版本号直接写在脚本里，更新后sed自动替换对应行
LOCAL_VER_webssh=v1.0.0
LOCAL_VER_dufs=v0.45.0
LOCAL_VER_cloudflared=2026.3.0
LOCAL_VER_easytier=v2.4.5
LOCAL_VER_uv=0.11.3
LOCAL_VER_opencode=v1.3.17
LOCAL_VER_subscheck=v1.5.2
# ================================================================================

# 获取root权限
# sudo su -
# 建立临时存放文件并进入
INSTALL_DIR="/root/bin"
DOWNLOAD_DIR="/root/temp"
[ -d "$DOWNLOAD_DIR" ] || mkdir -p "$DOWNLOAD_DIR"
cd "$DOWNLOAD_DIR" || exit 1
SCRIPT_SELF="$0"

# 基础依赖检查
for cmd in wget tar unzip curl; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "错误：请先安装 $cmd"
    exit 1
  fi
done


# ------------------------------------------------
# 纯 shell 获取 GitHub latest tag（无 jq）
# ------------------------------------------------
get_latest_github_tag() {
  local repo="$1"
  curl -sL "https://api.github.com/repos/$repo/releases/latest" \
  | grep -o '"tag_name": *"[^"]*"' \
  | head -n1 \
  | sed -E 's/"tag_name": *"([^"]*)"/\1/'
}

# ------------------------------------------------
# 纯 shell 读取本地版本（无 jq）
# ------------------------------------------------
get_local_version() {
  local app="LOCAL_VER_$1"
  awk -F= -v a="${app}" '$1==a{print $2}' "$SCRIPT_SELF"
}

# ------------------------------------------------
# # 更新脚本自身的版本号
# ------------------------------------------------
set_local_version() {
  local app="$1"
  local ver="$2"
  sed -i "s/^LOCAL_VER_$app=.*/LOCAL_VER_$app=$ver/" "$SCRIPT_SELF"
}


# ------------------------------------------------
# 1. webssh
# ------------------------------------------------
app="webssh"
repo="CJSen/cm-webssh"
bin="webssh"
remote_ver=$(get_latest_github_tag "$repo")
local_ver=$(get_local_version "$app")

if [ "$local_ver" != "$remote_ver" ] || [ ! -f "$INSTALL_DIR/$bin" ]; then
  echo "[$app] 本地: $local_ver | 最新: $remote_ver → 更新中"
  wget -O "$bin" "https://github.com/$repo/releases/download/$remote_ver/webssh-linux-amd64"
  chmod +x ./$bin && mv ./$bin $INSTALL_DIR
  set_local_version "$app" "$remote_ver"
  supervisorctl restart $bin
  echo "$bin更新完毕已重启"
else
  echo "[$app] 已是最新: $remote_ver"
fi

# ------------------------------------------------
# 2. dufs
# ------------------------------------------------
app="dufs"
repo="sigoden/dufs"
bin="dufs"
remote_ver=$(get_latest_github_tag "$repo")
local_ver=$(get_local_version "$app")

if [ "$local_ver" != "$remote_ver" ] || [ ! -f "$INSTALL_DIR/$bin" ]; then
  echo "[$app] 本地: $local_ver | 最新: $remote_ver → 更新中"
  wget -O dufs.tar.gz "https://github.com/$repo/releases/download/$remote_ver/dufs-$remote_ver-x86_64-unknown-linux-musl.tar.gz"
  tar -zxf dufs.tar.gz -C .
  rm -f dufs.tar.gz
  chmod +x ./$bin && mv ./$bin $INSTALL_DIR
  set_local_version "$app" "$remote_ver"
  supervisorctl restart $bin
  echo "$bin更新完毕已重启"
else
  echo "[$app] 已是最新: $remote_ver"
fi

# ------------------------------------------------
# 3. cloudflared
# ------------------------------------------------
app="cloudflared"
repo="cloudflare/cloudflared"
bin="cloudflared"
